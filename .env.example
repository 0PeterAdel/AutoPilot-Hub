# ═══════════════════════════════════════════════════
#          AutoPilot-Hub Configuration
# ═══════════════════════════════════════════════════
# Copy this file to .env and fill in your values
# cp .env.example .env
# ═══════════════════════════════════════════════════

# ── General ──
PROJECT_NAME=AutoPilot-Hub
ENVIRONMENT=development
DEBUG=true
LOG_LEVEL=INFO
TIMEZONE=Africa/Cairo

# ── Main Agent ──
MAIN_AGENT_HOST=0.0.0.0
MAIN_AGENT_PORT=8000
MAIN_AGENT_SECRET_KEY=change-this-to-a-random-secret-key

# ── PostgreSQL ──
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
POSTGRES_DB=autopilot_hub
POSTGRES_USER=autopilot
POSTGRES_PASSWORD=change-this-strong-password

# ── Redis ──
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_PASSWORD=change-this-redis-password
REDIS_DB=0

# ── RabbitMQ ──
RABBITMQ_HOST=rabbitmq
RABBITMQ_PORT=5672
RABBITMQ_MANAGEMENT_PORT=15672
RABBITMQ_USER=autopilot
RABBITMQ_PASSWORD=change-this-rabbitmq-password
RABBITMQ_VHOST=autopilot

# ── Ollama (Local LLM) ──
OLLAMA_HOST=ollama
OLLAMA_PORT=11434
OLLAMA_MODEL=llama3.1:8b
# Alternative models: mistral, codellama, llama3.1:70b

# ── Telegram Bot ──
TELEGRAM_BOT_TOKEN=your-telegram-bot-token-here
TELEGRAM_ALLOWED_USER_IDS=your-telegram-user-id
# Get your user ID: message @userinfobot on Telegram

# ── Gmail ──
GMAIL_ADDRESS=your-email@gmail.com
GMAIL_CLIENT_ID=your-google-client-id
GMAIL_CLIENT_SECRET=your-google-client-secret
GMAIL_CHECK_INTERVAL=300
# 300 = 5 minutes

# ── Freelancer Platforms ──
KHAMSAT_USERNAME=your-khamsat-username
KHAMSAT_PASSWORD=your-khamsat-password
MOSTAQL_USERNAME=your-mostaql-username
MOSTAQL_PASSWORD=your-mostaql-password
FREELANCE_CHECK_INTERVAL=900
# 900 = 15 minutes

# ── Bug Hunter ──
BUGHUNTER_THREADS=10
BUGHUNTER_RATE_LIMIT=100
# requests per second

# ── Services Ports ──
FREELANCER_SERVICE_PORT=8001
EMAIL_SERVICE_PORT=8002
DEVENV_SERVICE_PORT=8003
BUGHUNTER_SERVICE_PORT=8004
DASHBOARD_PORT=8080

# ── Monitoring ──
GRAFANA_PORT=3000
GRAFANA_ADMIN_PASSWORD=change-this-grafana-password
PROMETHEUS_PORT=9090

# ── Encryption ──
ENCRYPTION_KEY=generate-a-fernet-key-here
# Generate with: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"

# ── Daily Report ──
DAILY_REPORT_TIME=22:00
# 24h format, your timezone
